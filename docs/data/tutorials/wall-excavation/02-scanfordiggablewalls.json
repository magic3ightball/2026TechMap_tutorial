},{"line":85},{"line":88},{"line":89},{"line":90},{"line":91},{"line":92},{"line":93},{"line":94},{"line":95},{"line":96},{"line":97},{"line":98},{"line":99},{"line":100},{"line":101},{"line":102},{"line":103},{"line":104},{"line":105},{"line":106},{"line":107},{"line":109},{"line":110},{"line":111},{"line":112},{"line":113}],"fileName":"ExcavationTracker.swift","content":["import ARKit","import Observation","import RealityKit","","@MainActor","@Observable","final class ExcavationTracker {","    enum State: Equatable {","        case idle","        case requestingAuthorization","        case unsupported","        case authorizationDenied","        case scanning","        case failed(String)","    }","","    let rootEntity = Entity()","    private var session = ARKitSession()","    private var provider = PlaneDetectionProvider(alignments: [.vertical])","    private var markers: [UUID: PlaneMarker] = [:]","","    private(set) var state: State = .idle","","    var isImmersiveSpaceOpen: Bool {","        state != .idle","    }","","    var statusMessage: String {","        switch state {","        case .idle:","            \"발굴을 시작할 준비가 되었습니다.\"","        case .requestingAuthorization:","            \"주변 환경 접근 권한을 확인하고 있습니다.\"","        case .unsupported:","            \"이 기기에서는 평면 감지를 사용할 수 없습니다.\"","        case .authorizationDenied:","            \"평면 감지를 사용하려면 주변 환경 접근 권한이 필요합니다.\"","        case .scanning:","            \"벽을 천천히 바라보며 수직 평면을 찾으세요.\"","        case .failed(let message):","            \"평면 감지를 시작하지 못했습니다: \\(message)\"","        }","    }","","    func start() async {","        guard state != .scanning else {","            return","        }","","        guard PlaneDetectionProvider.isSupported else {","            state = .unsupported","            return","        }","","        \/\/ A stopped data provider can't run again, so each scan uses new instances.","        session = ARKitSession()","        provider = PlaneDetectionProvider(alignments: [.vertical])","","        state = .requestingAuthorization","        let authorization = await session.requestAuthorization(","            for: PlaneDetectionProvider.requiredAuthorizations","        )","        guard authorization[.worldSensing] == .allowed else {","            state = .authorizationDenied","            return","        }","","        do {","            try await session.run([provider])","            state = .scanning","","            for await update in provider.anchorUpdates {","                await process(update)","            }","        } catch {","            state = .failed(error.localizedDescription)","        }","    }","","    func stop() {","        session.stop()","        for marker in markers.values {","            marker.root.removeFromParent()","        }","        markers.removeAll()","        state = .idle","    }","","    private func process(_ update: AnchorUpdate<PlaneAnchor>) async {","        let anchor = update.anchor","","        switch update.event {","        case .added:","            do {","                let marker = try await PlaneMarker(anchor: anchor)","                markers[anchor.id] = marker","                rootEntity.addChild(marker.root)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .updated:","            do {","                try await markers[anchor.id]?.update(using: anchor)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .removed:","            markers[anchor.id]?.root.removeFromParent()","            markers.removeValue(forKey: anchor.id)","        }","    }","}"],"fileType":"swift","syntax":"swift"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/01-PrepareTheExcavationSpace#%EB%88%84%EC%A0%81-%EC%BD%94%EB%93%9C-%ED%8C%8C%EC%9D%BC-%EA%B5%AC%EC%84%B1%ED%95%98%EA%B8%B0":{"type":"section","abstract":[{"text":"새 visionOS 앱을 만들고, 다음 장의 평면 감지 코드를 받을