= .idle","","    var isImmersiveSpaceOpen: Bool {","        state != .idle","    }","","    var statusMessage: String {","        switch state {","        case .idle:","            \"발굴을 시작할 준비가 되었습니다.\"","        case .requestingAuthorization:","            \"주변 환경 접근 권한을 확인하고 있습니다.\"","        case .unsupported:","            \"이 기기에서는 평면 감지를 사용할 수 없습니다.\"","        case .authorizationDenied:","            \"평면 감지를 사용하려면 주변 환경 접근 권한이 필요합니다.\"","        case .scanning:","            \"벽을 천천히 바라보며 수직 평면을 찾으세요.\"","        case .failed(let message):","            \"평면 감지를 시작하지 못했습니다: \\(message)\"","        }","    }","","    func start() async {","        guard state != .scanning else {","            return","        }","","        guard PlaneDetectionProvider.isSupported else {","            state = .unsupported","            return","        }","","        \/\/ A stopped data provider can't run again, so each scan uses new instances.","        session = ARKitSession()","        provider = PlaneDetectionProvider(alignments: [.vertical])","","        state = .requestingAuthorization","        let authorization = await session.requestAuthorization(","            for: PlaneDetectionProvider.requiredAuthorizations","        )","        guard authorization[.worldSensing] == .allowed else {","            state = .authorizationDenied","            return","        }","","        do {","            try await session.run([provider])","            state = .scanning","        } catch {","            state = .failed(error.localizedDescription)","        }","    }","","    func stop() {","        session.stop()","        state = .idle","    }","","}"],"fileType":"swift","fileName":"ExcavationTracker.swift","syntax":"swift"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/01-PrepareTheExcavationSpace#%EC%B2%AB-%EB%B2%88%EC%A7%B8-%EC%8B%A4%ED%96%89-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"abstract":[{"type":"text","text":"새 visionOS 앱을 만들고, 다음 장의 평면 감지 코드를 받을 수 있는 Fu