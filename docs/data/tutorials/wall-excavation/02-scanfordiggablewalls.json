%9A%A9-%EB%AA%A9%EC%A0%81-%EC%B6%94%EA%B0%80%ED%95%98%EA%B8%B0","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/01-preparetheexcavationspace#world-sensing-%EC%82%AC%EC%9A%A9-%EB%AA%A9%EC%A0%81-%EC%B6%94%EA%B0%80%ED%95%98%EA%B8%B0","role":"pseudoSymbol"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#Apple-Vision-Pro%EC%97%90%EC%84%9C-%EB%B0%9C%EA%B5%B4%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#Apple-Vision-Pro%EC%97%90%EC%84%9C-%EB%B0%9C%EA%B5%B4%ED%95%98%EA%B8%B0","abstract":[{"type":"text","text":"감지된 벽을 흙 표면으로 덮고, 문지를수록 흙이 옅어지면서 숨겨진 암모나이트 화석이 드러나게 합니다."}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#Apple-Vision-Pro%EC%97%90%EC%84%9C-%EB%B0%9C%EA%B5%B4%ED%95%98%EA%B8%B0","title":"Apple Vision Pro에서 발굴하기"},"02-PlaneMarker.swift":{"syntax":"swift","fileType":"swift","fileName":"PlaneMarker.swift","identifier":"02-PlaneMarker.swift","highlights":[],"type":"file","content":["import ARKit","import RealityKit","import UIKit","","@MainActor","final class PlaneMarker {","    let root = Entity()","    private let model = ModelEntity()","","    init(anchor: PlaneAnchor) async throws {","        root.addChild(model)","        try await update(using: anchor)","    }","","    func update(using anchor: PlaneAnchor) async throws {","        let mesh = try await MeshResource(from: anchor)","        let material = UnlitMaterial(color: .cyan)","        model.model = ModelComponent(mesh: mesh, materials: [material])","        root.transform = Transform(matrix: anchor.originFromAnchorTransform)","    }","}"]},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#anchor-%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8%EC%97%90-%EC%9D%91%EB%8B%B5%ED%95%98%EA%B8%B0":{"title":"anchor 업데이트에 응답하기","abstract":[{"type":"codeVoice","code":"PlaneDetectionProvider"},{"type":"text","text":"를 실행하고, ARKit이 전달하는 수직 평면을 cyan 표시로 보여 줍니다."}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#anchor-%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8%EC%97%90-%EC%9D%91%EB%8B%B5%ED%95%98%EA%B8%B0","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#anchor-%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8%EC%97%90-%EC%9D%91%EB%8B%B5%ED%95%98%EA%B8%B0","role":"pseudoSymbol"},"02-ExcavationTracker-2.swift":{"syntax":"swift","fileType":"swift","fileName":"ExcavationTracker.swift","identifier":"02-ExcavationTracker-2.swift","highlights":[{"line":20},{"line":71},{"line":72},{"line":73},{"line":74},{"line":82},{"line":83},{"line":84},{"line":85},{"line":88},{"line":89},{"line":90},{"line":91},{"line":92},{"line":93},{"line":94},{"line":95},{"line":96},{"line":97},{"line":98},{"line":99},{"line":100},{"line":101},{"line":102},{"line":103},{"line":104},{"line":105},{"line":106},{"line":107},{"line":109},{"line":110},{"line":111},{"line":112},{"line":113}],"type":"file","content":["import ARKit","import Observation","import RealityKit","","@MainActor","@Observable","final class ExcavationTracker {","    enum State: Equatable {","        case idle","        case requestingAuthorization","        case unsupported","        case authorizationDenied","        case scanning","        case failed(String)","    }","","    let rootEntity = Entity()","    private var session = ARKitSession()","    private var provider = PlaneDetectionProvider(alignments: [.vertical])","    private var markers: [UUID: PlaneMarker] = [:]","","    private(set) var state: State = .idle","","    var isImmersiveSpaceOpen: Bool {","        state != .idle","    }","","    var statusMessage: String {","        switch state {","        case .idle:","            \"발굴을 시작할 준비가 되었습니다.\"","        case .requestingAuthorization:","            \"주변 환경 접근 권한을 확인하고 있습니다.\"","        case .unsupported:","            \"이 기기에서는 평면 감지를 사용할 수 없습니다.\"","        case .authorizationDenied:","            \"평면 감지를 사용하려면 주변 환경 접근 권한이 필요합니다.\"","        case .scanning:","            \"벽을 천천히 바라보며 수직 평면을 찾으세요.\"","        case .failed(let message):","            \"평면 감지를 시작하지 못했습니다: \\(message)\"","        }","    }","","    func start() async {","        guard state != .scanning else {","            return","        }","","        guard PlaneDetectionProvider.isSupported else {","            state = .unsupported","            return","        }","","        \/\/ A stopped data provider can't run again, so each scan uses new instances.","        session = ARKitSession()","        provider = PlaneDetectionProvider(alignments: [.vertical])","","        state = .requestingAuthorization","        let authorization = await session.requestAuthorization(","            for: PlaneDetectionProvider.requiredAuthorizations","        )","        guard authorization[.worldSensing] == .allowed else {","            state = .authorizationDenied","            return","        }","","        do {","            try await session.run([provider])","            state = .scanning","","            for await update in provider.anchorUpdates {","                await process(update)","            }","        } catch {","            state = .failed(error.localizedDescription)","        }","    }","","    func stop() {","        session.stop()","        for marker in markers.values {","            marker.root.removeFromParent()","        }","        markers.removeAll()","        state = .idle","    }","","    private func process(_ update: AnchorUpdate<PlaneAnchor>) async {","        let anchor = update.anchor","","        switch update.event {","        case .added:","            do {","                let marker = try await PlaneMarker(anchor: anchor)","                markers[anchor.id] = marker","                rootEntity.addChild(marker.root)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .updated:","            do {","                try await markers[anchor.id]?.update(using: anchor)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .removed:","            markers[anchor.id]?.root.removeFromParent()","            markers.removeValue(forKey: anchor.id)","        }","    }","}"]},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation/Plane-Detection/-----------":{"title":"긁어서 화석 드러내기","abstract":[],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation\/Plane-Detection\/-----------","kind":"article","type":"topic","url":"\/tutorials\/planeexcavation\/plane-detection\/-----------","role":"article"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%ED%9D%99%EA%B3%BC-%ED%99%94%EC%84%9D%EC%9C%BC%EB%A1%9C-%EB%B0%9C%EA%B5%B4-%ED%98%84%EC%9E%A5-%EB%A7%8C%EB%93%A4%EA%B8%B0":{"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%ED%9D%99%EA%B3%BC-%ED%99%94%EC%84%9D%EC%9C%BC%EB%A1%9C-%EB%B0%9C%EA%B5%B4-%ED%98%84%EC%9E%A5-%EB%A7%8C%EB%93%A4%EA%B8%B0","abstract":[{"type":"text","text":"감지된 벽을 흙 표면으로 덮고, 문지를수록 흙이 옅어지면서 숨겨진 암모나이트 화석이 드러나게 합니다."}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%ED%9D%99%EA%B3%BC-%ED%99%94%EC%84%9D%EC%9C%BC%EB%A1%9C-%EB%B0%9C%EA%B5%B4-%ED%98%84%EC%9E%A5-%EB%A7%8C%EB%93%A4%EA%B8%B0","title":"흙과 화석으로 발굴 현장 만들기"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0%EC%97%90%EC%84%9C-%EC%97%B0%EC%8A%B5-%EB%B2%BD%EC%9C%BC%EB%A1%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0%EC%97%90%EC%84%9C-%EC%97%B0%EC%8A%B5-%EB%B2%BD%EC%9C%BC%EB%A1%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","abstract":[{"type":"text","text":"감지된 벽을 흙 표면으로 덮고, 문지를수록 흙이 옅어지면서 숨겨진 암모나이트 화석이 드러나게 합니다."}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0%EC%97%90%EC%84%9C-%EC%97%B0%EC%8A%B5-%EB%B2%BD%EC%9C%BC%EB%A1%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","title":"시뮬레이터에서 연습 벽으로 확인하기"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%EC%99%84%EC%84%B1-%EA%B2%B0%EA%B3%BC%EC%99%80-%EB%AC%B8%EC%A0%9C-%ED%95%B4%EA%B2%B0-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%EC%99%84%EC%84%B1-%EA%B2%B0%EA%B3%BC%EC%99%80-%EB%AC%B8%EC%A0%9C-%ED%95%B4%EA%B2%B0-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","abstract":[{"type":"text","text":"감지된 벽을 흙 표면으로 덮고, 문지를수록 흙이 옅어지면서 숨겨진 암모나이트 화석이 드러나게 합니다."}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%EC%99%84%EC%84%B1-%EA%B2%B0%EA%B3%BC%EC%99%80-%EB%AC%B8%EC%A0%9C-%ED%95%B4%EA%B2%B0-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","title":"완성 결과와 문제 해결 확인하기"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation":{"role":"overview","kind":"overview","type":"topic","url":"\/tutorials\/planeexcavation","abstract":[{"text":"수직 평면을 감지하고, 감지된 표면에 상호 작용하는 발굴 레이어를 배치합니다.","type":"text"}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation","title":"감지된 벽 평면에서 유물을 드러내기"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0":{"title":"평면 감지 흐름 이해하기","abstract":[{"code":"PlaneDetectionProvider","type":"codeVoice"},{"text":"를 실행하고, ARKit이 전달하는 수직 평면을 cyan 표시로 보여 줍니다.","type":"text"}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0","role":"pseudoSymbol"},"result-ch2.jpg":{"type":"image","identifier":"result-ch2.jpg","alt":"예시 그림: 방의 벽 위에 반투명한 cyan 평면 표시가 겹쳐 보인다","variants":[{"url":"\/images\/com.techmap.plane-excavation\/result-ch2.jpg","traits":["1x","light"]}]},"02-ExcavationTracker-1.swift":{"syntax":"swift","fileType":"swift","fileName":"ExcavationTracker.swift","identifier":"02-ExcavationTracker-1.swift","highlights":[],"type":"file","content":["import ARKit","import Observation","import RealityKit","","@MainActor","@Observable","final class ExcavationTracker {","    enum State: Equatable {","        case idle","        case requestingAuthorization","        case unsupported","        case authorizationDenied","        case scanning","        case failed(String)","    }","","    let rootEntity = Entity()","    private var session = ARKitSession()","    private var provider = PlaneDetectionProvider(alignments: [.vertical])","","    private(set) var state: State = .idle","","    var isImmersiveSpaceOpen: Bool {","        state != .idle","    }","","    var statusMessage: String {","        switch state {","        case .idle:","            \"발굴을 시작할 준비가 되었습니다.\"","        case .requestingAuthorization:","            \"주변 환경 접근 권한을 확인하고 있습니다.\"","        case .unsupported:","            \"이 기기에서는 평면 감지를 사용할 수 없습니다.\"","        case .authorizationDenied:","            \"평면 감지를 사용하려면 주변 환경 접근 권한이 필요합니다.\"","        case .scanning:","            \"벽을 천천히 바라보며 수직 평면을 찾으세요.\"","        case .failed(let message):","            \"평면 감지를 시작하지 못했습니다: \\(message)\"","        }","    }","","    func start() async {","        guard state != .scanning else {","            return","        }","","        guard PlaneDetectionProvider.isSupported else {","            state = .unsupported","            return","        }","","        \/\/ A stopped data provider can't run again, so each scan uses new instances.","        session = ARKitSession()","        provider = PlaneDetectionProvider(alignments: [.vertical])","","        state = .requestingAuthorization","        let authorization = await session.requestAuthorization(","            for: PlaneDetectionProvider.requiredAuthorizations","        )","        guard authorization[.worldSensing] == .allowed else {","            state = .authorizationDenied","            return","        }","","        do {","            try await session.run([provider])","            state = .scanning","        } catch {","            state = .failed(error.localizedDescription)","        }","    }","","    func stop() {","        session.stop()","        state = .idle","    }","","}"]},"hero-dark-ch2.jpg":{"type":"image","identifier":"hero-dark-ch2.jpg","alt":"어두운 공간의 벽 위에 cyan 평면 표시가 있고 문은 제외되어 있다","variants":[{"url":"\/images\/com.techmap.plane-excavation\/hero-dark-ch2.jpg","traits":["1x","light"]}]},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%ED%8F%89%EB%A9%B4-%ED%91%9C%EC%8B%9C%EB%A5%BC-%EB%B0%9C%EA%B5%B4-%ED%91%9C%EB%A9%B4%EC%9C%BC%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0":{"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%ED%8F%89%EB%A9%B4-%ED%91%9C%EC%8B%9C%EB%A5%BC-%EB%B0%9C%EA%B5%B4-%ED%91%9C%EB%A9%B4%EC%9C%BC%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0","abstract":[{"type":"text","text":"감지된 벽을 흙 표면으로 덮고, 문지를수록 흙이 옅어지면서 숨겨진 암모나이트 화석이 드러나게 합니다."}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%ED%8F%89%EB%A9%B4-%ED%91%9C%EC%8B%9C%EB%A5%BC-%EB%B0%9C%EA%B5%B4-%ED%91%9C%EB%A9%B4%EC%9C%BC%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0","title":"평면 표시를 발굴 표면으로 바꾸기"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4%EC%9D%B4-%EB%B3%B4%EC%9D%B4%EC%A7%80-%EC%95%8A%EC%9D%84-%EB%95%8C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#%ED%8F%89%EB%A9%B4%EC%9D%B4-%EB%B3%B4%EC%9D%B4%EC%A7%80-%EC%95%8A%EC%9D%84-%EB%95%8C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","abstract":[{"type":"codeVoice","code":"PlaneDetectionProvider"},{"type":"text","text":"를 실행하고, ARKit이 전달하는 수직 평면을 cyan 표시로 보여 줍니다."}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4%EC%9D%B4-%EB%B3%B4%EC%9D%B4%EC%A7%80-%EC%95%8A%EC%9D%84-%EB%95%8C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","title":"평면이 보이지 않을 때 확인하기"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/01-PrepareTheExcavationSpace#%EC%B2%AB-%EB%B2%88%EC%A7%B8-%EC%8B%A4%ED%96%89-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"title":"첫 번째 실행 확인하기","abstract":[{"text":"새 visionOS 앱을 만들고, 다음 장의 평면 감지 코드를 받을 수 있는 Full Space 구조를 준비합니다.","type":"text"}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/01-PrepareTheExcavationSpace#%EC%B2%AB-%EB%B2%88%EC%A7%B8-%EC%8B%A4%ED%96%89-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/01-preparetheexcavationspace#%EC%B2%AB-%EB%B2%88%EC%A7%B8-%EC%8B%A4%ED%96%89-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","role":"pseudoSymbol"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#Check-Your-Understanding":{"type":"link","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#Check-Your-Understanding","title":"Check Your Understanding","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#Check-Your-Understanding"},"doc://com.techmap.plane-excavation/tutoria