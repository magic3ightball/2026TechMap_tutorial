Wall-Excavation/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0":{"type":"section","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0","kind":"section","abstract":[{"type":"codeVoice","code":"PlaneDetectionProvider"},{"type":"text","text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다."}],"title":"평면 감지 흐름 이해하기","role":"pseudoSymbol","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls","abstract":[{"code":"PlaneDetectionProvider","type":"codeVoice"},{"text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다.","type":"text"}],"title":"수직 벽 평면 감지하기","role":"project","estimatedTime":"40min","kind":"project","type":"topic"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation/-----------":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation\/-----------","url":"\/tutorials\/planeexcavation\/-----------","abstract":[],"title":"긁어서 화석 드러내기","role":"article","kind":"article","type":"topic"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%EB%B0%9C%EA%B5%B4-%EC%83%81%ED%98%B8-%EC%9E%91%EC%9A%A9-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0":{"type":"section","kind":"section","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%EB%B0%9C%EA%B5%B4-%EC%83%81%ED%98%B8-%EC%9E%91%EC%9A%A9-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0","abstract":[{"text":"감지된 평면을 상호 작용 가능한 갈색 발굴 표면으로 바꾸고, 드래그 입력으로 숨겨진 유물을 표시합니다.","type":"text"}],"title":"발굴 상호 작용 실행하기","role":"pseudoSymbol","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%EB%B0%9C%EA%B5%B4-%EC%83%81%ED%98%B8-%EC%9E%91%EC%9A%A9-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0"},"02-ExcavationTracker.swift":{"type":"file","fileType":"swift","identifier":"02-ExcavationTracker.swift","content":["import ARKit","import Observation","import RealityKit","","@MainActor","@Observable","final class ExcavationTracker {","    enum State: Equatable {","        case idle","        case requestingAuthorization","        case unsupported","        case authorizationDenied","        case scanning","        case failed(String)","    }","","    let rootEntity = Entity()","    private let session = ARKitSession()","    private let provider = PlaneDetectionProvider(alignments: [.vertical])","    private var markers: [UUID: PlaneMarker] = [:]","","    private(set) var state: State = .idle","","    var statusMessage: String {","        switch state {","        case .idle:","            \"발굴을 시작할 준비가 되었습니다.\"","        case .requestingAuthorization:","            \"주변 환경 접근 권한을 확인하고 있습니다.\"","        case .unsupported:","            \"이 기기에서는 평면 감지를 사용할 수 없습니다.\"","        case .authorizationDenied:","            \"평면 감지를 사용하려면 주변 환경 접근 권한이 필요합니다.\"","        case .scanning:","            \"벽을 천천히 바라보며 수직 평면을 찾으세요.\"","        case .failed(let message):","            \"평면 감지를 시작하지 못했습니다: \\(message)\"","        }","    }","","    func start() async {","        guard state != .scanning else {","            return","        }","","        guard PlaneDetectionProvider.isSupported else {","            state = .unsupported","            return","        }","","        state = .requestingAuthorization","        let authorization = await session.requestAuthorization(","            for: PlaneDetectionProvider.requiredAuthorizations","        )","        guard authorization[.worldSensing] == .allowed else {","            state = .authorizationDenied","            return","        }","","        do {","            try await session.run([provider])","            state = .scanning","","            for await update in provider.anchorUpdates {","                await process(update)","            }","        } catch {","            state = .failed(error.localizedDescription)","        }","    }","","    func stop() {","        session.stop()","        for marker in markers.values {","            marker.root.removeFromParent()","        }","        markers.removeAll()","        state = .idle","    }","","    private func process(_ update: AnchorUpdate<PlaneAnchor>) async {","        let anchor = update.anchor","","        switch update.event {","        case .added:","            do {","                let marker = try await PlaneMarker(anchor: anchor)","                markers[anchor.id] = marker","                rootEntity.addChild(marker.root)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .updated:","            do {","                try await markers[anchor.id]?.update(using: anchor)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .removed:","            markers[anchor.id]?.root.removeFromParent()","            markers.removeValue(forKey: anchor.id)","        }","    }","}"],"fileName":"ExcavationTracker.swift","syntax":"swift","highlights":[]},"02-PlaneMarker.swift":{"content":["import ARKit","import RealityKit","","@MainActor","final class PlaneMarker {","    let root = Entity()","    private let model = ModelEntity()","","    init(anchor: PlaneAnchor) async throws {","        root.addChild(model)","        try await update(using: anchor)","    }","","    func update(using anchor: PlaneAnchor) async throws {","        let mesh = try await MeshResource(from: anchor)","        let material = UnlitMaterial(color: .cyan)","        model.model = ModelComponent(mesh: mesh, materials: [material])","        root.transform = Transform(matrix: anchor.originFromAnchorTransform)","    }","}"],"identifier":"02-PlaneMarker.swift","fileType":"swift","highlights":[],"type":"file","fileName":"PlaneMarker.swift","syntax":"swift"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation/----":{"type":"topic","kind":"article","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation\/----","abstract":[],"title":"벽 스캔","role":"article","url":"\/tutorials\/planeexcavation\/----"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#anchor-%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8%EC%97%90-%EC%9D%91%EB%8B%B5%ED%95%98%EA%B8%B0":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#anchor-%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8%EC%97%90-%EC%9D%91%EB%8B%B5%ED%95%98%EA%B8%B0","role":"pseudoSymbol","type":"section","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#anchor-%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8%EC%97%90-%EC%9D%91%EB%8B%B5%ED%95%98%EA%B8%B0","title":"anchor 업데이트에 응답하기","abstract":[{"type":"codeVoice","code":"PlaneDetectionProvider"},{"type":"text","text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다."}],"kind":"section"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/01-PrepareTheExcavationSpace#visionOS-%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EB%A7%8C%EB%93%A4%EA%B8%B0":{"url":"\/tutorials\/wall-excavation\/01-preparetheexcavationspace#visionOS-%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EB%A7%8C%EB%93%A4%EA%B8%B0","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/01-PrepareTheExcavationSpace#visionOS-%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EB%A7%8C%EB%93%A4%EA%B8%B0","type":"section","abstract":[{"text":"새 visionOS 앱을 만들고, 다음 장의 평면 감지 코드를 받을 수 있는 Full Space 구조를 준비합니다.","type":"text"}],"role":"pseudoSymbol","title":"visionOS 프로젝트 만들기","kind":"section"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation/--------":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation\/--------","role":"article","type":"topic","url":"\/tutorials\/planeexcavation\/--------","title":"발굴 공간 준비","abstract":[],"kind":"article"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation","url":"\/tutorials\/planeexcavation","abstract":[{"type":"text","text":"수직 평면을 감지하고, 감지된 표면에 상호 작용하는 발굴 레이어를 배치합니다."}],"title":"감지된 벽 평면에서 유물을 드러내기","role":"overview","kind":"overview","type":"topic"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%ED%8F%89%EB%A9%B4-marker%EB%A5%BC-%EB%B0%9C%EA%B5%B4-surface%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%ED%8F%89%EB%A9%B4-marker%EB%A5%BC-%EB%B0%9C%EA%B5%B4-surface%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%ED%8F%89%EB%A9%B4-marker%EB%A5%BC-%EB%B0%9C%EA%B5%B4-surface%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0","abstract":[{"text":"감지된 평면을 상호 작용 가능한 갈색 발굴 표면으로 바꾸고, 드래그 입력으로 숨겨진 유물을 표시합니다.","type":"text"}],"title":"평면 marker를 발굴 surface로 바꾸기","role":"pseudoSymbol","kind":"section","type":"section"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4%EC%9D%B4-%EB%B3%B4%EC%9D%B4%EC%A7%80-%EC%95%8A%EC%9D%84-%EB%95%8C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"kind":"section","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#%ED%8F%89%EB%A9%B4%EC%9D%B4-%EB%B3%B4%EC%9D%B4%EC%A7%80-%EC%95%8A%EC%9D%84-%EB%95%8C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","type":"section","abstract":[{"type":"codeVoice","code":"PlaneDetectionProvider"},{"text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다.","type":"text"}],"role":"pseudoSymbol","title":"평면이 보이지 않을 때 확인하기","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanF