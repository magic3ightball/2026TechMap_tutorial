B4-surface%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%ED%8F%89%EB%A9%B4-marker%EB%A5%BC-%EB%B0%9C%EA%B5%B4-surface%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0","abstract":[{"text":"감지된 평면을 상호 작용 가능한 갈색 발굴 표면으로 바꾸고, 드래그 입력으로 숨겨진 유물을 표시합니다.","type":"text"}],"title":"평면 marker를 발굴 surface로 바꾸기","role":"pseudoSymbol","kind":"section","type":"section"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation","url":"\/tutorials\/planeexcavation","abstract":[{"type":"text","text":"수직 평면을 감지하고, 감지된 표면에 상호 작용하는 발굴 레이어를 배치합니다."}],"title":"감지된 벽 평면에서 유물을 드러내기","role":"overview","kind":"overview","type":"topic"},"03-ExcavationWall.swift":{"type":"file","fileType":"swift","identifier":"03-ExcavationWall.swift","content":["import ARKit","import RealityKit","","@MainActor","final class ExcavationWall {","    let root = Entity()","","    private let cover = ModelEntity()","    private let artifact = ModelEntity(","        mesh: .generateSphere(radius: 0.08),","        materials: [SimpleMaterial(color: .orange, isMetallic: false)]","    )","","    private var brushCount = 0","    private var lastBrushTime = Date.distantPast","    private let requiredBrushCount = 6","","    init(anchor: PlaneAnchor) async throws {","        root.addChild(artifact)","        root.addChild(cover)","","        \/\/ This placeholder stands in for a fossil asset in the final experience.","        artifact.position = [0, 0, 0.02]","        artifact.isEnabled = false","","        cover.name = anchor.id.uuidString","        cover.components.set(InputTargetComponent())","        try await update(using: anchor)","    }","","    func update(using anchor: PlaneAnchor) async throws {","        let mesh = try await MeshResource(from: anchor)","        let material = SimpleMaterial(color: .brown, isMetallic: false)","        cover.model = ModelComponent(mesh: mesh, materials: [material])","        cover.generateCollisionShapes(recursive: false)","        root.transform = Transform(matrix: anchor.originFromAnchorTransform)","    }","","    func brush() {","        guard cover.isEnabled else {","            return","        }","","        let now = Date.now","        guard now.timeIntervalSince(lastBrushTime) >= 0.25 else {","            return","        }","        lastBrushTime = now","","        brushCount += 1","        guard brushCount >= requiredBrushCount else {","            return","        }","","        cover.isEnabled = false","        artifact.isEnabled = true","    }","}"],"fileName":"ExcavationWall.swift","syntax":"swift","highlights":[]},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#PlaneDetectionProvider-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#PlaneDetectionProvider-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0","role":"pseudoSymbol","type":"section","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#PlaneDetectionProvider-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0","title":"PlaneDetectionProvider 실행하기","abstract":[{"code":"PlaneDetectionProvider","type":"codeVoice"},{"text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다.","type":"text"}],"kind":"section"},"03-ExcavationTracker.swift":{"content":["import ARKit","import Observation","import RealityKit","","@MainActor","@Observable","final class ExcavationTracker {","    enum State: Equatable {","        case idle","        case requestingAuthorization","        case unsupported","        case authorizationDenied","        case scanning","        case failed(String)","    }","","    let rootEntity = Entity()","    private let session = ARKitSession()","    private let provider = PlaneDetectionProvider(alignments: [.vertical])","    private var walls: [UUID: ExcavationWall] = [:]","","    private(set) var state: State = .idle","","    var statusMessage: String {","        switch state {","        case .idle:","            \"발굴을 시작할 준비가 되었습니다.\"","        case .requestingAuthorization:","            \"주변 환경 접근 권한을 확인하고 있습니다.\"","        case .unsupported:","            \"이 기기에서는 평면 감지를 사용할 수 없습니다.\"","        case .authorizationDenied:","            \"평면 감지를 사용하려면 주변 환경 접근 권한이 필요합니다.\"","        case .scanning:","            \"벽을 천천히 바라본 뒤, 갈색 발굴 표면을 문지르세요.\"","        case .failed(let message):","            \"평면 감지를 시작하지 못했습니다: \\(message)\"","        }","    }","","    func start() async {","        guard state != .scanning else {","            return","        }","","        guard PlaneDetectionProvider.isSupported else {","            state = .unsupported","            return","        }","","        state = .requestingAuthorization","        let authorization = await session.requestAuthorization(","            for: PlaneDetectionProvider.requiredAuthorizations","        )","        guard authorization[.worldSensing] == .allowed else {","            state = .authorizationDenied","            return","        }","","        do {","            try await session.run([provider])","            state = .scanning","","            for await update in provider.anchorUpdates {","                await process(update)","            }","        } catch {","            state = .failed(error.localizedDescription)","        }","    }","","    func stop() {","        session.stop()","        for wall in walls.values {","            wall.root.removeFromParent()","        }","        walls.removeAll()","        state = .idle","    }","","    func brush(entity: Entity) {","        guard let anchorID = UUID(uuidString: entity.name) else {","            return","        }","","        walls[anchorID]?.brush()","    }","","    private func process(_ update: AnchorUpdate<PlaneAnchor>) async {","        let anchor = update.anchor","","        switch update.event {","        case .added:","            do {","                let wall = try await ExcavationWall(anchor: anchor)","                walls[anchor.id] = wall","                rootEntity.addChild(wall.root)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .updated:","            do {","                try await walls[anchor.id]?.update(using: anchor)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .removed:","            walls[anchor.id]?.root.removeFromParent()","            walls.removeValue(forKey: anchor.id)","        }","    }","}"],"identifier":"03-ExcavationTracker.swift","fileType":"swift","highlights":[],"type":"file","fileName":"ExcavationTracker.swift","syntax":"swift"},"03-ImmersiveView.swift":{"content":["import RealityKit","import SwiftUI","","struct ImmersiveView: View {","    @Environment(ExcavationTracker.self) private var tracker","","    var body: some View {","        RealityView { content in","            content.add(tracker.rootEntity)","        }","        .task {","            await tracker.start()","        }","        .onDisappear {","            tracker.stop()","        }","        .gesture(","            DragGesture(minimumDistance: 0)","                .targetedToAnyEntity()","                .onChanged { value in","                    tracker.brush(entity: value.entity)","                }","        )","    }","}"],"identifier":"03-ImmersiveView.swift","fileName":"ImmersiveView.swift","highlights":[],"syntax":"swift","type":"file","fileType":"swift"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/01-PrepareTheExcavationSpace#world-sensing-%EC%82%AC%EC%9A%A9-%EB%AA%A9%EC%A0%81-%EC%B6%94%EA%B0%80%ED%95%98%EA%B8%B0":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/01-PrepareTheExcavationSpace#world-sensing-%EC%82%AC%EC%9A%A9-%EB%AA%A9%EC%A0%81-%EC%B6%94%EA%B0%80%ED%95%98%EA%B8%B0","url":"\/tutorials\/wall-excavation\/01-preparetheexcavationspace#world-sensing-%EC%82%AC%EC%9A%A9-%EB%AA%A9%EC%A0%81-%EC%B6%94%EA%B0%80%ED%95%98%EA%B8%B0","abstract":[{"text":"새 visionOS 앱을 만들고, 다음 장의 평면 감지 코드를 받을 수 있는 Full Space 구조를 준비합니다.","type":"text"}],"title":"world-sensing 사용 목적 추가하기","role":"pseudoSymbol","kind":"section","type":"section"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4%EC%9D%B4-%EB%B3%B4%EC%9D%B4%EC%A7%80-%EC%95%8A%EC%9D%84-%EB%95%8C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"kind":"section","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#%ED%8F%89%EB%A9%B4%EC%9D%B4-%EB%B3%B4%EC%9D%B4%EC%A7%80-%EC%95%8A%EC%9D%84-%EB%95%8C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","type":"section","abstract":[{"type":"codeVoice","code":"PlaneDetectionProvider"},{"text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다.","type":"text"}],"role":"pseudoSymbol","title":"평면이 보이지 않을 때 확인하기","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4%EC%9D%B4-%EB%B3%B4%EC%9D%B4%EC%A7%80-%EC%95%8A%EC%9D%84-%EB%95%8C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0":{"type":"section","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0","kind":"section","abstract":[{"type":"codeVoice","code":"PlaneDetectionProvider"},{"type":"text","text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다."}],"title":"평면 감지 흐름 이해하기","role":"pseudoSymbol","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/01-PrepareTheExcavationSpace#visionOS-%