},{"line":112},{"line":113},{"line":114},{"line":115},{"line":116},{"line":117}],"type":"file","content":["import ARKit","import Observation","import RealityKit","","@MainActor","@Observable","final class ExcavationTracker {","    enum State: Equatable {","        case idle","        case requestingAuthorization","        case unsupported","        case authorizationDenied","        case scanning","        case practice","        case failed(String)","    }","","    let rootEntity = Entity()","    private var session = ARKitSession()","    private var provider = PlaneDetectionProvider(alignments: [.vertical])","    private var walls: [UUID: ExcavationWall] = [:]","","    private(set) var state: State = .idle","","    var isImmersiveSpaceOpen: Bool {","        state != .idle","    }","","    var statusMessage: String {","        switch state {","        case .idle:","            \"발굴을 시작할 준비가 되었습니다.\"","        case .requestingAuthorization:","            \"주변 환경 접근 권한을 확인하고 있습니다.\"","        case .unsupported:","            \"이 기기에서는 평면 감지를 사용할 수 없습니다.\"","        case .authorizationDenied:","            \"평면 감지를 사용하려면 주변 환경 접근 권한이 필요합니다.\"","        case .scanning:","            \"벽을 천천히 바라본 뒤, 갈색 발굴 표면을 문지르세요.\"","        case .practice:","            \"시뮬레이터에서는 실제 벽 대신 연습용 벽을 표시합니다. 갈색 표면을 문지르세요.\"","        case .failed(let message):","            \"평면 감지를 시작하지 못했습니다: \\(message)\"","        }","    }","","    func start() async {","        #if targetEnvironment(simulator)","        showPracticeWall()","        #else","        await startPlaneDetection()","        #endif","    }","","    private func startPlaneDetection() async {","        guard state != .scanning else {","            return","        }","","        guard PlaneDetectionProvider.isSupported else {","            state = .unsupported","            return","        }","","        \/\/ A stopped data provider can't run again, so each scan uses new instances.","        session = ARKitSession()","        provider = PlaneDetectionProvider(alignments: [.vertical])","","        state = .requestingAuthorization","        let authorization = await session.requestAuthorization(","            for: PlaneDetectionProvider.requiredAuthorizations","        )","        guard authorization[.worldSensing] == .allowed else {","            state = .authorizationDenied","            return","        }","","        do {","            try await session.run([provider])","            state = .scanning","","            for await update in provider.anchorUpdates {","                await process(update)","            }","        } catch {","            state = .failed(error.localizedDescription)","        }","    }","","    func stop() {","        session.stop()","        for wall in walls.values {","            wall.root.removeFromParent()","        }","        walls.removeAll()","        state = .idle","    }","","    func brush(entity: Entity) {","        guard let anchorID = UUID(uuidString: entity.name) else {","            return","        }","","        walls[anchorID]?.brush()","    }","","    private func showPracticeWall() {","        guard walls.isEmpty else {","            return","        }","","        let id = UUID()","        let wall = ExcavationWall(practiceWallID: id)","        walls[id] = wall","        rootEntity.addChild(wall.root)","        state = .practice","    }","","    private func process(_ update: AnchorUpdate<PlaneAnchor>) async {","        let anchor = update.anchor","","        switch update.event {","        case .added:","            do {","                let wall = try await ExcavationWall(anchor: anchor)","                walls[anchor.id] = wall","                rootEntity.addChild(wall.root)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .updated:","            do {","                try await walls[anchor.id]?.update(using: anchor)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .removed:","            walls[anchor.id]?.root.removeFromParent()","            walls.removeValue(forKey: anchor.id)","        }","    }","}"],"identifier":"03-ExcavationTracker-3.swift","syntax":"swift","fileName":"ExcavationTracker.swift"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","abstract":[{"code":"PlaneDetectionProvider","type":"codeVoice"},{"text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다.","type":"text"}],"title":"평면 감지 흐름 이해하기","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#%ED%8F%89%EB%A9%B4-%EA%B0%90%EC%A7%80-%ED%9D%90%EB%A6%84-%EC%9D%B4%ED%95%B4%ED%95%98%EA%B8%B0","kind":"section"},"03-ExcavationWall-1.swift":{"fileType":"swift","highlights":[],"type":"file","content":["import ARKit","import RealityKit","","@MainActor","final class ExcavationWall {","    let root = Entity()","","    private let cover = ModelEntity()","    private let artifact = ModelEntity(","        mesh: .generateSphere(radius: 0.08),","        materials: [SimpleMaterial(color: .orange, isMetallic: false)]","    )","","    init(anchor: PlaneAnchor) async throws {","        configure(id: anchor.id)","        try await update(using: anchor)","    }","","    func update(using anchor: PlaneAnchor) async throws {","        let mesh = try await MeshResource(from: anchor)","        applyCover(mesh: mesh)","        root.transform = Transform(matrix: anchor.originFromAnchorTransform)","    }","","    private func configure(id: UUID) {","        root.addChild(artifact)","        root.addChild(cover)","","        \/\/ This placeholder stands in for a fossil asset in the final experience.","        artifact.position = [0, 0, 0.02]","        artifact.isEnabled = false","","        cover.name = id.uuidString","        cover.components.set(InputTargetComponent())","    }","","    private func applyCover(mesh: MeshResource) {","        let material = SimpleMaterial(color: .brown, isMetallic: false)","        cover.model = ModelComponent(mesh: mesh, materials: [material])","        cover.generateCollisionShapes(recursive: false)","    }","}"],"identifier":"03-ExcavationWall-1.swift","syntax":"swift","fileName":"ExcavationWall.swift"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation/--------":{"role":"article","type":"topic","abstract":[],"title":"발굴 공간 준비","url":"\/tutorials\/planeexcavation\/--------","kind":"article","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation\/--------"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/01-PrepareTheExcavationSpace#%EC%B2%AB-%EB%B2%88%EC%A7%B8-%EC%8B%A4%ED%96%89-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","abstract":[{"text":"새 visionOS 앱을 만들고, 다음 장의 평면 감지 코드를 받을 수 있는 Full Space 구조를 준비합니다.","type":"text"}],"title":"첫 번째 실행 확인하기","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/01-PrepareTheExcavationSpace#%EC%B2%AB-%EB%B2%88%EC%A7%B8-%EC%8B%A4%ED%96%89-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","url":"\/tutorials\/wall-excavation\/01-preparetheexcavationspace#%EC%B2%AB-%EB%B2%88%EC%A7%B8-%EC%8B%A4%ED%96%89-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","kind":"section"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%ED%8F%89%EB%A9%B4-marker%EB%A5%BC-%EB%B0%9C%EA%B5%B4-surface%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0":{"role":"pseudoSymbol","type":"section","abstract":[{"text":"감지된 평면을 상호 작용 가능한 갈색 발굴 표면으로 바꾸고, 문지를수록 옅어지는 표면 아래에서 숨겨진 유물을 표시합니다.","type":"text"}],"title":"평면 marker를 발굴 surface로 바꾸기","identifier":"doc:\/\/com.