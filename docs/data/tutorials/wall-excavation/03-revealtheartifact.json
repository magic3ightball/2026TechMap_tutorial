ce.generatePlane","type":"codeVoice"},{"text":"으로 만든 1.2m × 0.8m 평면이며, cover·collision·brush 처리는 실제 벽과 같은 코드를 공유합니다.","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}]},{"anchor":"완성-결과와-문제-해결-확인하기","stepsSection":[{"caption":[],"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"text":"벽을 추가로 관찰해 anchor가 갱신된 뒤에도 cover를 문지를 수 있는지 확인합니다. 이 검사는 ","type":"text"},{"code":"applyCover(mesh:)","type":"codeVoice"},{"text":"가 갱신된 mesh에 collision shape를 다시 생성하는지 확인합니다.","type":"text"}]}],"code":"03-ExcavationWall-3.swift","type":"step","media":null},{"caption":[],"runtimePreview":null,"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"발굴 종료","type":"text"}]},{"text":"를 선택했다가 다시 ","type":"text"},{"type":"strong","inlineContent":[{"text":"발굴 시작","type":"text"}]},{"text":"을 선택합니다. 이전 발굴 surface가 남지 않고 새 평면 감지가 시작되면 ","type":"text"},{"code":"stop()","type":"codeVoice"},{"text":"의 정리 코드와 ","type":"text"},{"code":"startPlaneDetection()","type":"codeVoice"},{"text":"의 provider 재생성이 함께 동작한 것입니다.","type":"text"}]}],"code":"03-ExcavationTracker-3.swift","type":"step","media":null}],"title":"완성 결과와 문제 해결 확인하기","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"다음 순서가 모두 동작하면 튜토리얼을 완료한 것입니다.","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"앱이 world-sensing 권한을 요청합니다."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"ARKit이 수직 평면을 감지합니다."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"anchor update에 맞춰 갈색 cover의 위치와 모양이 갱신됩니다."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"targeted drag 입력이 cover entity에 전달되고 cover가 점점 옅어집니다."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"입력 횟수가 충족되면 cover가 사라지고 artifact가 표시됩니다."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"cover는 보이지만 입력되지 않는다면 ","type":"text"},{"code":"InputTargetComponent","type":"codeVoice"},{"text":"와 collision shape 생성 코드를 확인합니다. 입력은 되지만 artifact가 보이지 않는다면 ","type":"text"},{"code":"artifact.isEnabled","type":"codeVoice"},{"text":" 변경과 주황색 material을 확인합니다.","type":"text"}]}],"kind":"contentAndMedia","mediaPosition":"trailing"}]}],"kind":"tasks"}],"variants":[{"paths":["\/tutorials\/wall-excavation\/03-revealtheartifact"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact","interfaceLanguage":"swift"},"kind":"project","references":{"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0%EC%97%90%EC%84%9C-%EC%97%B0%EC%8A%B5-%EB%B2%BD%EC%9C%BC%EB%A1%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","abstract":[{"type":"text","text":"감지된 평면을 상호 작용 가능한 갈색 발굴 표면으로 바꾸고, 문지를수록 옅어지는 표면 아래에서 숨겨진 유물을 표시합니다."}],"title":"시뮬레이터에서 연습 벽으로 확인하기","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0%EC%97%90%EC%84%9C-%EC%97%B0%EC%8A%B5-%EB%B2%BD%EC%9C%BC%EB%A1%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0%EC%97%90%EC%84%9C-%EC%97%B0%EC%8A%B5-%EB%B2%BD%EC%9C%BC%EB%A1%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","kind":"section"},"03-ExcavationWall-2.swift":{"fileType":"swift","highlights":[{"line":14},{"line":15},{"line":16},{"line":17},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49}],"type":"file","content":["import ARKit","import RealityKit","","@MainActor","final class ExcavationWall {","    let root = Entity()","","    private let cover = ModelEntity()","    private let artifact = ModelEntity(","        mesh: .generateSphere(radius: 0.08),","        materials: [SimpleMaterial(color: .orange, isMetallic: false)]","    )","","    private var brushCount = 0","    private var lastBrushTime = Date.distantPast","    private let requiredBrushCount = 6","","    init(anchor: PlaneAnchor) async throws {","        configure(id: anchor.id)","        try await update(using: anchor)","    }","","    func update(using anchor: PlaneAnchor) async throws {","        let mesh = try await MeshResource(from: anchor)","        applyCover(mesh: mesh)","        root.transform = Transform(matrix: anchor.originFromAnchorTransform)","    }","","    func brush() {","        guard cover.isEnabled else {","            return","        }","","        let now = Date.now","        guard now.timeIntervalSince(lastBrushTime) >= 0.25 else {","            return","        }","        lastBrushTime = now","","        brushCount += 1","        guard brushCount >= requiredBrushCount else {","            \/\/ Fade the cover a little on every brush so progress is visible.","            let progress = Float(brushCount) \/ Float(requiredBrushCount)","            cover.components.set(OpacityComponent(opacity: 1 - progress * 0.7))","            return","        }","","        cover.isEnabled = false","        artifact.isEnabled = true","    }","","    private func configure(id: UUID) {","        root.addChild(artifact)","        root.addChild(cover)","","        \/\/ This placeholder stands in for a fossil asset in the final experience.","        artifact.position = [0, 0, 0.02]","        artifact.isEnabled = false","","        cover.name = id.uuidString","        cover.components.set(InputTargetComponent())","    }","","    private func applyCover(mesh: MeshResource) {","        let material = SimpleMaterial(color: .brown, isMetallic: false)","        cover.model = ModelComponent(mesh: mesh, materials: [material])","        cover.generateCollisionShapes(recursive: false)","    }","}"],"identifier":"03-ExcavationWall-2.swift","syntax":"swift","fileName":"ExcavationWall.swift"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#anchor-%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8%EC%97%90-%EC%9D%91%EB%8B%B5%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","abstract":[{"code":"PlaneDetectionProvider","type":"codeVoice"},{"type":"text","text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다."}],"title":"anchor 업데이트에 응답하기","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#anchor-%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8%EC%97%90-%EC%9D%91%EB%8B%B5%ED%95%98%EA%B8%B0","kind":"section","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#anchor-%EC%97%85%EB%8D%B0%EC%9D%B4%ED%8A%B8%EC%97%90-%EC%9D%91%EB%8B%B5%ED%95%98%EA%B8%B0"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation/----":{"role":"article","type":"topic","abstract":[],"title":"벽 스캔","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation\/----","url":"\/tutorials\/planeexcavation\/----","kind":"article"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#Apple-Vision-Pro%EC%97%90%EC%84%9C-%EB%B0%9C%EA%B5%B4%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","abstract":[{"text":"감지된 평면을 상호 작용 가능한 갈색 발굴 표면으로 바꾸고, 문지를수록 옅어지는 표면 아래에서 숨겨진 유물을 표시합니다.","type":"text"}],"title":"Apple Vision Pro에서 발굴하기","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#Apple-Vision-Pro%EC%97%90%EC%84%9C-%EB%B0%9C%EA%B5%B4%ED%95%98%EA%B8%B0","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#Apple-Vision-Pro%EC%97%90%EC%84%9C-%EB%B0%9C%EA%B5%B4%ED%95%98%EA%B8%B0","kind":"section"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation":{"role":"overview","type":"topic","abstract":[{"type":"text","text":"수직 평면을 감지하고, 감지된 표면에 상호 작용하는 발굴 레이어를 배치합니다."}],"title":"감지된 벽 평면에서 유물을 드러내기","url":"\/tutorials\/planeexcavation","kind":"overview","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation/-----------":{"role":"article","type":"topic","abstract":[],"title":"긁어서 화석 드러내기","url":"\/tutorials\/planeexcavation\/-----------","kind":"article","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation\/-----------"},"03-ExcavationWall-3.swift":{"fileType":"swift","highlights":[{"line":23},{"line":24},{"line":25},{"line":26},{"line":27},{"line":28},{"line":29}],"type":"file","content":["import ARKit","import RealityKit","","@MainActor","final class ExcavationWall {","    let root = Entity()","","    private let cover = ModelEntity()","    private let artifact = ModelEntity(","        mesh: .generateSphere(radius: 0.08),","        materials: [SimpleMaterial(color: .orange, isMetallic: false)]","    )","","    private var brushCount = 0","    private var lastBrushTime = Date.distantPast","    private let requiredBrushCount = 6","","    init(anchor: PlaneAnchor) async throws {","        configure(id: anchor.id)","        try await update(using: anchor)","    }","","    \/\/\/ Creates a wall in front of the person for Simulator, where plane detection isn't available.","    init(practiceWallID id: UUID) {","        configure(id: id)","        applyCover(mesh: .generatePlane(width: 1.2, height: 0.8))","        root.position = [0, 1.4, -1.5]","    }","","    func update(using anchor: PlaneAnchor) async throws {","        let mesh = try await MeshResource(from: anchor)","        applyCover(mesh: mesh)","        root.transform = Transform(matrix: anchor.originFromAnchorTransform)","    }","","    func brush() {","        guard cover.isEnabled else {","            return","        }","","        let now = Date.now","        guard now.timeIntervalSince(lastBrushTime) >= 0.25 else {","            return","        }","        lastBrushTime = now","","        brushCount += 1","        guard brushCount >= requiredBrushCount else {","            \/\/ Fade the cover a little on every brush so progress is visible.","            let progress = Float(brushCount) \/ Float(requiredBrushCount)","            cover.components.set(OpacityComponent(opacity: 1 - progress * 0.7))","            return","        }","","        cover.isEnabled = false","        artifact.isEnabled = true","    }","","    private func configure(id: UUID) {","        root.addChild(artifact)","        root.addChild(cover)","","        \/\/ This placeholder stands in for a fossil asset in the final experience.","        artifact.position = [0, 0, 0.02]","        artifact.isEnabled = false","","        cover.name = id.uuidString","        cover.components.set(InputTargetComponent())","    }","","    private func applyCover(mesh: MeshResource) {","        let material = SimpleMaterial(color: .brown, isMetallic: false)","        cover.model = ModelComponent(mesh: mesh, materials: [material])","        cover.generateCollisionShapes(recursive: false)","    }","}"],"identifier":"03-ExcavationWall-3.swift","syntax":"swift","fileName":"ExcavationWall.swift"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%EB%AC%B8%EC%A7%80%EB%A5%B4%EA%B8%B0-%EC%9E%85%EB%A0%A5-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","abstract":[{"text":"감지된 평면을 상호 작용 가능한 갈색 발굴 표면으로 바꾸고, 문지를수록 옅어지는 표면 아래에서 숨겨진 유물을 표시합니다.","type":"text"}],"title":"문지르기 입력 연결하기","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%EB%AC%B8%EC%A7%80%EB%A5%B4%EA%B8%B0-%EC%9E%85%EB%A0%A5-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%EB%AC%B8%EC%A7%80%EB%A5%B4%EA%B8%B0-%EC%9E%85%EB%A0%A5-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0","kind":"section"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#PlaneDetectionProvider-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","abstract":[{"code":"PlaneDetectionProvider","type":"codeVoice"},{"text":"를 실행하고, ARKit이 전달하는 수직 평면을 파란 mesh로 표시합니다.","type":"text"}],"title":"PlaneDetectionProvider 실행하기","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/02-ScanForDiggableWalls#PlaneDetectionProvider-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0","kind":"section","url":"\/tutorials\/wall-excavation\/02-scanfordiggablewalls#PlaneDetectionProvider-%EC%8B%A4%ED%96%89%ED%95%98%EA%B8%B0"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/01-PrepareTheExcavationSpace#%EB%88%84%EC%A0%81-%EC%BD%94%EB%93%9C-%ED%8C%8C%EC%9D%BC-%EA%B5%AC%EC%84%B1%ED%95%98%EA%B8%B0":{"role":"pseudoSymbol","type":"section","abstract":[{"text":"새 visionOS 앱을 만들고, 다음 장의 평면 감지 코드를 받을 수 있는 Full Space 구조를 준비합니다.","type":"text"}],"title":"누적 코드 파일 구성하기","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/01-PrepareTheExcavationSpace#%EB%88%84%EC%A0%81-%EC%BD%94%EB%93%9C-%ED%8C%8C%EC%9D%BC-%EA%B5%AC%EC%84%B1%ED%95%98%EA%B8%B0","url":"\/tutorials\/wall-excavation\/01-preparetheexcavationspace#%EB%88%84%EC%A0%81-%EC%BD%94%EB%93%9C-%ED%8C%8C%EC%9D%BC-%EA%B5%AC%EC%84%B1%ED%95%98%EA%B8%B0","kind":"section"},"03-ExcavationTracker-2.swift":{"fileType":"swift","highlights":[{"line":89},{"line":90},{"line":91},{"line":92},{"line":93},{"line":94},{"line":95},{"line":96}],"type":"file","content":["import ARKit","import Observation","import RealityKit","","@MainActor","@Observable","final class ExcavationTracker {","    enum State: Equatable {","        case idle","        case requestingAuthorization","        case unsupported","        case authorizationDenied","        case scanning","        case failed(String)","    }","","    let rootEntity = Entity()","    private var session = ARKitSession()","    private var provider = PlaneDetectionProvider(alignments: [.vertical])","    private var walls: [UUID: ExcavationWall] = [:]","","    private(set) var state: State = .idle","","    var isImmersiveSpaceOpen: Bool {","        state != .idle","    }","","    var statusMessage: String {","        switch state {","        case .idle:","            \"발굴을 시작할 준비가 되었습니다.\"","        case .requestingAuthorization:","            \"주변 환경 접근 권한을 확인하고 있습니다.\"","        case .unsupported:","            \"이 기기에서는 평면 감지를 사용할 수 없습니다.\"","        case .authorizationDenied:","            \"평면 감지를 사용하려면 주변 환경 접근 권한이 필요합니다.\"","        case .scanning:","            \"벽을 천천히 바라본 뒤, 갈색 발굴 표면을 문지르세요.\"","        case .failed(let message):","            \"평면 감지를 시작하지 못했습니다: \\(message)\"","        }","    }","","    func start() async {","        guard state != .scanning else {","            return","        }","","        guard PlaneDetectionProvider.isSupported else {","            state = .unsupported","            return","        }","","        \/\/ A stopped data provider can't run again, so each scan uses new instances.","        session = ARKitSession()","        provider = PlaneDetectionProvider(alignments: [.vertical])","","        state = .requestingAuthorization","        let authorization = await session.requestAuthorization(","            for: PlaneDetectionProvider.requiredAuthorizations","        )","        guard authorization[.worldSensing] == .allowed else {","            state = .authorizationDenied","            return","        }","","        do {","            try await session.run([provider])","            state = .scanning","","            for await update in provider.anchorUpdates {","                await process(update)","            }","        } catch {","            state = .failed(error.localizedDescription)","        }","    }","","    func stop() {","        session.stop()","        for wall in walls.values {","            wall.root.removeFromParent()","        }","        walls.removeAll()","        state = .idle","    }","","    func brush(entity: Entity) {","        guard let anchorID = UUID(uuidString: entity.name) else {","            return","        }","","        walls[anchorID]?.brush()","    }","","    private func process(_ update: AnchorUpdate<PlaneAnchor>) async {","        let anchor = update.anchor","","        switch update.event {","        case .added:","            do {","                let wall = try await ExcavationWall(anchor: anchor)","                walls[anchor.id] = wall","                rootEntity.addChild(wall.root)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .updated:","            do {","                try await walls[anchor.id]?.update(using: anchor)","            } catch {","                state = .failed(error.localizedDescription)","            }","","        case .removed:","            walls[anchor.id]?.root.removeFromParent()","            walls.removeValue(forKey: anchor.id)","        }","    }","}"],"identifier":"03-ExcavationTracker-2.swift","syntax":"swift","fileName":"ExcavationTracker.swift"},"03-ImmersiveView.swift":{"fileType":"swift","highlights":[{"line":17},{"line":18},{"line":19},{"line":20},{"line":21},{"line":22},{"line":23}],"type":"file","content":["import RealityKit","import SwiftUI","","struct ImmersiveView: View {","    @Environment(ExcavationTracker.self) private var tracker","","    var body: some View {","        RealityView { content in","            content.add(tracker.rootEntity)","        }","        .task {","            await tracker.start()","        }","        .onDisappear {","            tracker.stop()","        }","        .gesture(","            DragGesture(minimumDistance: 0)","                .targetedToAnyEntity()","                .onChanged { value in","                    tracker.brush(entity: value.entity)","                }","        )","    }","}"],"identifi