pace) private var openImmersiveSpace","    @Environment(\\.dismissImmersiveSpace) private var dismissImmersiveSpace","","    @State private var launchMessage: String?","    @State private var isOpeningImmersiveSpace = false","","    var body: some View {","        VStack {","            Text(\"벽 발굴 체험\")","                .font(.title)","","            Text(\"수직 벽을 스캔한 뒤 표면을 문질러 숨겨진 화석을 찾습니다.\")","                .multilineTextAlignment(.center)","","            if tracker.isImmersiveSpaceOpen {","                Button(\"발굴 종료\", action: closeExcavationSpace)","                    .buttonStyle(.bordered)","            } else {","                Button(\"발굴 시작\", action: openExcavationSpace)","                    .buttonStyle(.borderedProminent)","                    .disabled(isOpeningImmersiveSpace)","            }","","            if isOpeningImmersiveSpace {","                ProgressView(\"공간을 여는 중\")","            }","","            Text(launchMessage ?? tracker.statusMessage)","                .foregroundStyle(.secondary)","                .multilineTextAlignment(.center)","                .accessibilityLabel(\"앱 상태: \\(launchMessage ?? tracker.statusMessage)\")","        }","        .padding()","    }","","    private func openExcavationSpace() {","        isOpeningImmersiveSpace = true","        launchMessage = nil","","        Task {","            let result = await openImmersiveSpace(id: \"ExcavationSpace\")","            isOpeningImmersiveSpace = false","","            switch result {","            case .opened:","                break","            case .userCancelled:","                launchMessage = \"발굴 공간 열기를 취소했습니다.\"","            case .error:","                launchMessage = \"발굴 공간을 열 수 없습니다. 잠시 후 다시 시도하세요.\"","            @unknown default:","                launchMessage = \"알 수 없는 이유로 발굴 공간을 열 수 없습니다.\"","            }","        }","    }","","    private func closeExcavationSpace() {","        Task {","            await dismissImmersiveSpace()","        }","    }","}"]},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%ED%8F%89%EB%A9%B4-%ED%91%9C%EC%8B%9C%EB%A5%BC-%EB%B0%9C%EA%B5%B4-%ED%91%9C%EB%A9%B4%EC%9C%BC%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0":{"kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%ED%8F%89%EB%A9%B4-%ED%91%9C%EC%8B%9C%EB%A5%BC-%EB%B0%9C%EA%B5%B4-%ED%91%9C%EB%A9%B4%EC%9C%BC%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0","role":"pseudoSymbol","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%ED%8F%89%EB%A9%B4-%ED%91%9C%EC%8B%9C%EB%A5%BC-%EB%B0%9C%EA%B5%B4-%ED%91%9C%EB%A9%B4%EC%9C%BC%EB%A1%9C-%EB%B0%94%EA%BE%B8%EA%B8%B0","title":"평면 표시를 발굴 표면으로 바꾸기","abstract":[{"text":"감지된 벽을 흙 표면으로 덮고, 문지를수록 흙이 옅어지면서 숨겨진 암모나이트 화석이 드러나게 합니다.","type":"text"}]},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation/Plane-Detection/--------":{"kind":"article","type":"topic","url":"\/tutorials\/planeexcavation\/plane-detection\/--------","role":"article","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation\/Plane-Detection\/--------","title":"발굴 공간 준비","abstract":[]},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%EB%AC%B8%EC%A7%80%EB%A5%B4%EA%B8%B0-%EC%9E%85%EB%A0%A5-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0":{"kind":"section","type":"section","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%EB%AC%B8%EC%A7%80%EB%A5%B4%EA%B8%B0-%EC%9E%85%EB%A0%A5-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0","role":"pseudoSymbol","identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%EB%AC%B8%EC%A7%80%EB%A5%B4%EA%B8%B0-%EC%9E%85%EB%A0%A5-%EC%97%B0%EA%B2%B0%ED%95%98%EA%B8%B0","title":"문지르기 입력 연결하기","abstract":[{"text":"감지된 벽을 흙 표면으로 덮고, 문지를수록 흙이 옅어지면서 숨겨진 암모나이트 화석이 드러나게 합니다.","type":"text"}]},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/01-PrepareTheExcavationSpace#%EB%88%84%EC%A0