."}],"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation","url":"\/tutorials\/planeexcavation","role":"overview","title":"감지된 벽 평면에서 유물을 드러내기","type":"topic","kind":"overview"},"01-ContentView.swift":{"identifier":"01-ContentView.swift","type":"file","highlights":[],"content":["import SwiftUI","","struct ContentView: View {","    @Environment(ExcavationTracker.self) private var tracker","    @Environment(\\.openImmersiveSpace) private var openImmersiveSpace","    @Environment(\\.dismissImmersiveSpace) private var dismissImmersiveSpace","","    @State private var launchMessage: String?","    @State private var isOpeningImmersiveSpace = false","","    var body: some View {","        VStack {","            Text(\"벽 발굴 체험\")","                .font(.title)","","            Text(\"수직 벽을 스캔한 뒤 표면을 문질러 숨겨진 화석을 찾습니다.\")","                .multilineTextAlignment(.center)","","            if tracker.isImmersiveSpaceOpen {","                Button(\"발굴 종료\", action: closeExcavationSpace)","                    .buttonStyle(.bordered)","            } else {","                Button(\"발굴 시작\", action: openExcavationSpace)","                    .buttonStyle(.borderedProminent)","                    .disabled(isOpeningImmersiveSpace)","            }","","            if isOpeningImmersiveSpace {","                ProgressView(\"공간을 여는 중\")","            }","","            Text(launchMessage ?? tracker.statusMessage)","                .foregroundStyle(.secondary)","                .multilineTextAlignment(.center)","                .accessibilityLabel(\"앱 상태: \\(launchMessage ?? tracker.statusMessage)\")","        }","        .padding()","    }","","    private func openExcavationSpace() {","        isOpeningImmersiveSpace = true","        launchMessage = nil","","        Task {","            let result = await openImmersiveSpace(id: \"ExcavationSpace\")","            isOpeningImmersiveSpace = false","","            switch result {","            case .opened:","                break","            case .userCancelled:","                launchMessage = \"발굴 공간 열기를 취소했습니다.\"","            case .error:","                launchMessage = \"발굴 공간을 열 수 없습니다. 잠시 후 다시 시도하세요.\"","            @unknown default:","                launchMessage = \"알 수 없는 이유로 발굴 공간을 열 수 없습니다.\"","            }","        }","    }","","    private func closeExcavationSpace() {","        Task {","            await dismissImmersiveSpace()","        }","    }","}"],"fileName":"ContentView.swift","fileType":"swift","syntax":"swift"},"doc://com.techmap.plane-excavation/tutorials/PlaneExcavation/Plane-Detection/--------":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/PlaneExcavation\/Plane-Detection\/--------","abstract":[],"title":"발굴 공간 준비","type":"topic","kind":"article","url":"\/tutorials\/planeexcavation\/plane-detection\/--------","role":"article"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%EC%99%84%EC%84%B1-%EA%B2%B0%EA%B3%BC%EC%99%80-%EB%AC%B8%EC%A0%9C-%ED%95%B4%EA%B2%B0-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Excavation\/03-RevealTheArtifact#%EC%99%84%EC%84%B1-%EA%B2%B0%EA%B3%BC%EC%99%80-%EB%AC%B8%EC%A0%9C-%ED%95%B4%EA%B2%B0-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","type":"section","title":"완성 결과와 문제 해결 확인하기","abstract":[{"text":"감지된 평면을 상호 작용 가능한 갈색 발굴 표면으로 바꾸고, 문지를수록 옅어지는 표면 아래에서 숨겨진 유물을 표시합니다.","type":"text"}],"kind":"section","url":"\/tutorials\/wall-excavation\/03-revealtheartifact#%EC%99%84%EC%84%B1-%EA%B2%B0%EA%B3%BC%EC%99%80-%EB%AC%B8%EC%A0%9C-%ED%95%B4%EA%B2%B0-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0","role":"pseudoSymbol"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/03-RevealTheArtifact#%EC%8B%9C%EB%AE%AC%EB%A0%88%EC%9D%B4%ED%84%B0%EC%97%90%EC%84%9C-%EC%97%B0%EC%8A%B5-%EB%B2%BD%EC%9C%BC%EB%A1%9C-%ED%99%95%EC%9D%B8%ED%95%98%EA%B8%B0":{"identifier":"doc:\/\/com.techmap.plane-excavation\/tutorials\/Wall-Exc