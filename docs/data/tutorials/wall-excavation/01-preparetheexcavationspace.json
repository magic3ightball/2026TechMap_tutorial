 false","","    var body: some View {","        VStack {","            Text(\"벽 발굴 체험\")","                .font(.title)","","            Text(\"수직 벽을 스캔한 뒤 표면을 문질러 숨겨진 화석을 찾습니다.\")","                .multilineTextAlignment(.center)","","            if tracker.isImmersiveSpaceOpen {","                Button(\"발굴 종료\", action: closeExcavationSpace)","                    .buttonStyle(.bordered)","            } else {","                Button(\"발굴 시작\", action: openExcavationSpace)","                    .buttonStyle(.borderedProminent)","                    .disabled(isOpeningImmersiveSpace)","            }","","            if isOpeningImmersiveSpace {","                ProgressView(\"공간을 여는 중\")","            }","","            Text(launchMessage ?? tracker.statusMessage)","                .foregroundStyle(.secondary)","                .multilineTextAlignment(.center)","                .accessibilityLabel(\"앱 상태: \\(launchMessage ?? tracker.statusMessage)\")","        }","        .padding()","    }","","    private func openExcavationSpace() {","        isOpeningImmersiveSpace = true","        launchMessage = nil","","        Task {","            let result = await openImmersiveSpace(id: \"ExcavationSpace\")","            isOpeningImmersiveSpace = false","","            switch result {","            case .opened:","                break","            case .userCancelled:","                launchMessage = \"발굴 공간 열기를 취소했습니다.\"","            case .error:","                launchMessage = \"발굴 공간을 열 수 없습니다. 잠시 후 다시 시도하세요.\"","            @unknown default:","                launchMessage = \"알 수 없는 이유로 발굴 공간을 열 수 없습니다.\"","            }","        }","    }","","    private func closeExcavationSpace() {","        Task {","            await dismissImmersiveSpace()","        }","    }","}"],"identifier":"01-ContentView.swift","syntax":"swift","fileName":"ContentView.swift"},"doc://com.techmap.plane-excavation/tutorials/Wall-Excavation/02-ScanForDiggableWalls#%ED%8F%89%EB%A9%